{
  "name": "playwright-adventures-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run check:journeys --silent && tsc -p tsconfig.json",
    "check:journeys": "node scripts/generateJourneyAdapters.mjs --check",
    "generate:journeys": "node scripts/generateJourneyAdapters.mjs",
    "test:journeys": "node --test scripts/generateJourneyAdapters.test.mjs",
    "test:fixture": "node --test ../fixture-app/server.test.mjs",
    "test:mcp": "npm run build --silent && node --test dist/tests/mcp/*.test.js",
    "test:mcp:browser": "npm run build --silent && node --test dist/tests/integration/mcpBrowserSecurity.test.js",
    "test:smoke": "playwright test tests/smoke",
    "start:mcp": "tsx src/mcp/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
